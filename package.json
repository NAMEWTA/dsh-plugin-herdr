{
  "name": "workbench-monorepo",
  "version": "1.0.3-alpha.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "engines": { "node": ">=24.22.0 <25" },
  "scripts": {
    "build": "node tooling/build.mjs",
    "dev": "vite --config apps/dev-workbench/vite.config.ts",
    "check:architecture": "node tooling/check-architecture.mjs",
    "typecheck": "tsc --noEmit",
    "gen:protocol": "node tooling/gen-protocol.mjs",
    "gen:protocol:check": "node tooling/gen-protocol.mjs --check",
    "gen:contracts:check": "node tooling/gen-remote.mjs --check",
    "test:unit": "node --experimental-transform-types --test \"tests/unit/*.test.ts\" \"modules/herdr/test/*.test.ts\"",
    "test:components": "vitest run --config vitest.config.ts",
    "test:e2e": "node tests/e2e/run.mjs && node tests/e2e/inspector.mjs && node tests/e2e/rail-shadow.mjs",
    "test:integration": "node --experimental-transform-types --test \"tests/integration/*.test.ts\"",
    "test:package": "node --test \"tests/packaging/*.test.mjs\"",
    "quality": "pnpm build && pnpm typecheck && pnpm check:architecture && pnpm gen:protocol:check && pnpm gen:contracts:check && pnpm test:unit && pnpm test:components && pnpm test:package",
    "pack:plugin": "node tooling/pack.mjs",
    "check:package": "node tooling/check-package.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-crypto": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "@base-ui/react": "1.9.0",
    "@tanstack/react-query": "5.104.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.60.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5",
    "postcss": "8.5.31",
    "@workbench/contracts": "workspace:*",
    "@workbench/core": "workspace:*",
    "@workbench/sdk": "workspace:*",
    "@workbench/ui": "workspace:*",
    "@workbench/shell": "workspace:*",
    "@workbench/testkit": "workspace:*",
    "@workbench/herdr": "workspace:*",
    "@workbench/example-notes": "workspace:*"
  }
